{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitae.local/schemas/docs/common.schema.json",
  "title": "Vitae documentation schema definitions",
  "description": "Shared schema definitions for LLM-readable Vitae documentation artifacts.",
  "$defs": {
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "docId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "enum": [
            "source",
            "evidence",
            "related",
            "supersedes",
            "superseded-by",
            "implements",
            "blocks",
            "blocked-by"
          ]
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "maturity": {
      "type": "string",
      "enum": ["brief", "standard", "full"]
    },
    "complexity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "llmSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "canonicalQuestions"],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "canonicalQuestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "readerHints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
