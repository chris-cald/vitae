{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitae.local/schemas/career/cover-letter.schema.json",
  "title": "Vitae Cover letter",
  "description": "Canonical application-bound communication deliverable with block-level provenance or explicit human confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "applicationId", "bundleId", "targetId", "materialCategory", "sourceRefs", "contentBlocks"],
  "properties": {
    "id": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" },
    "kind": { "const": "cover-letter" },
    "applicationId": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" },
    "bundleId": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" },
    "targetId": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" },
    "materialCategory": { "const": "communications" },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/sourceRef" }
    },
    "catalogAssetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" }
    },
    "projectionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" }
    },
    "contentBlocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/deliverableContentBlock" }
    },
    "needsHumanConfirmation": { "type": "boolean" }
  }
}
