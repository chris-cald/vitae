{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitae.local/schemas/career/profile.schema.json",
  "title": "Vitae Profile",
  "description": "Canonical, persistence-neutral profile record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "displayName"
  ],
  "properties": {
    "id": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId"
    },
    "kind": {
      "const": "profile"
    },
    "displayName": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/nonEmptyString"
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "preferences": {
      "type": "object"
    }
  }
}
