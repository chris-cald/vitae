{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitae.local/schemas/career/evidence.schema.json",
  "title": "Vitae Evidence",
  "description": "Canonical, persistence-neutral evidence record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "claim",
    "sourceRefs"
  ],
  "properties": {
    "id": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId"
    },
    "kind": {
      "const": "evidence"
    },
    "claim": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/nonEmptyString"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/sourceRef"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
