{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitae.local/schemas/career/projection.schema.json",
  "title": "Vitae Projection",
  "description": "Canonical, persistence-neutral projection record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "inputRef",
    "outputKind",
    "method"
  ],
  "properties": {
    "id": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId"
    },
    "kind": {
      "const": "projection"
    },
    "inputRef": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/sourceRef"
    },
    "outputKind": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/nonEmptyString"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
