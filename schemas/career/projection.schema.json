{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitae.local/schemas/career/projection.schema.json",
  "title": "Vitae Projection",
  "description": "Canonical, persistence-neutral downstream communication derived from validated CatalogAssets; it is never first factual evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "derivedFromCatalogAssetIds", "inputRef", "outputKind", "method"],
  "properties": {
    "id": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" },
    "kind": { "const": "projection" },
    "derivedFromCatalogAssetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" }
    },
    "inputRef": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/sourceRef",
      "description": "Reference to the transformation input or rendering context; factual support remains with derivedFromCatalogAssetIds."
    },
    "outputKind": { "type": "string", "minLength": 1 },
    "method": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/nonEmptyString" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
