{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitae.local/schemas/career/fit-analysis.schema.json",
  "title": "Vitae Fit analysis",
  "description": "Canonical, persistence-neutral fit analysis with requirement mappings embedded in the analysis record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "profileId", "targetId", "requirementMappings"],
  "properties": {
    "id": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" },
    "kind": { "const": "fit-analysis" },
    "profileId": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" },
    "targetId": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "requirementMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "assessment", "method"],
        "properties": {
          "requirementId": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" },
          "assessment": { "enum": ["matched", "partial", "gap", "unsupported"] },
          "catalogAssetIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId" }
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/sourceRef" }
          },
          "method": { "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/nonEmptyString" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "needsHumanConfirmation": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "assessment": { "enum": ["matched", "partial"] } }, "required": ["assessment"] },
            "then": { "required": ["catalogAssetIds", "sourceRefs"] }
          }
        ]
      }
    }
  }
}
