{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitae.local/schemas/career/deliverable.schema.json",
  "title": "Vitae Deliverable",
  "description": "Canonical, persistence-neutral deliverable record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "deliverableType",
    "title",
    "sourceRefs"
  ],
  "properties": {
    "id": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/entityId"
    },
    "kind": {
      "const": "deliverable"
    },
    "deliverableType": {
      "enum": [
        "resume-variant",
        "cover-letter",
        "recruiter-brief",
        "application-packet",
        "prompt-bundle",
        "other"
      ]
    },
    "title": {
      "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/nonEmptyString"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://vitae.local/schemas/career/common.schema.json#/$defs/sourceRef"
      }
    },
    "needsHumanConfirmation": {
      "type": "boolean"
    }
  }
}
