{
  "name": "@templjs/cli",
  "version": "0.1.0",
  "description": "Command-line interface for templjs template processing",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "templjs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "cli",
    "template",
    "code-generation",
    "templjs",
    "command-line"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/templjs/templ.js.git",
    "directory": "src/packages/cli"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@templjs/core": "file:../core",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.0",
    "jsonparse": "^1.3.1",
    "xml2js": "^0.6.2"
  }
}
