{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/vitae.sdlc/metadata/adr",
  "title": "vitae.sdlc/metadata/adr",
  "description": "Canonical Doc-Vader metadata contract for Vitae Architecture Decision Records.",
  "type": "object",
  "required": [
    "namespace",
    "type",
    "id",
    "status",
    "title",
    "decisionDate",
    "owners",
    "maturity",
    "complexity",
    "llm"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$content_schema": {
      "type": "string"
    },
    "namespace": {
      "const": "vitae.sdlc"
    },
    "type": {
      "const": "adr"
    },
    "id": {
      "$ref": "/vitae.sdlc/metadata/common#/$defs/docId"
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "deprecated", "superseded"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "decisionDate": {
      "$ref": "/vitae.sdlc/metadata/common#/$defs/isoDate"
    },
    "lastUpdated": {
      "$ref": "/vitae.sdlc/metadata/common#/$defs/isoDate"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "/vitae.sdlc/metadata/common#/$defs/owner"
      }
    },
    "maturity": {
      "$ref": "/vitae.sdlc/metadata/common#/$defs/maturity"
    },
    "complexity": {
      "$ref": "/vitae.sdlc/metadata/common#/$defs/complexity"
    },
    "decisionScope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "product",
          "architecture",
          "data-model",
          "api",
          "frontend",
          "backend",
          "ai-ml",
          "workflow",
          "security",
          "privacy",
          "operations",
          "documentation"
        ]
      },
      "uniqueItems": true
    },
    "affectedSystems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "/vitae.sdlc/metadata/common#/$defs/docId"
      },
      "uniqueItems": true
    },
    "supersededBy": {
      "$ref": "/vitae.sdlc/metadata/common#/$defs/docId"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "/vitae.sdlc/metadata/common#/$defs/link"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "llm": {
      "$ref": "/vitae.sdlc/metadata/common#/$defs/llmSummary"
    }
  },
  "allOf": [
    { "$ref": "/metadata/base" },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["supersededBy"]
      }
    }
  ],
  "unevaluatedProperties": false
}
